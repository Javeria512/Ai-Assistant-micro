# Copy to `mobile/.env` to override where the app looks for the FastAPI backend.
#
# Leave it unset for the default behaviour: with `adb reverse tcp:8000 tcp:8000`
# the app uses http://localhost:8000; otherwise it falls back to whichever host
# served the JS bundle (your LAN IP on a device, 10.0.2.2 on an emulator).
#
# Metro caches transformed modules, so restart with `npm start -- --reset-cache`
# after changing this.
API_URL=http://192.168.1.20:8000
