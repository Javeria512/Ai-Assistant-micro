# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit the real .env.
# ---------------------------------------------------------------------------

# --- Microsoft Entra ID app registration ------------------------------------
CLIENT_ID=your-application-client-id
CLIENT_SECRET=your-client-secret
TENANT_ID=your-directory-tenant-id
# Must match a Redirect URI registered on the app (Web platform).
REDIRECT_URI=http://localhost:8000/auth/microsoft/callback

# "common" allows any work/school account (multi-tenant).
# Set to "organizations" or your TENANT_ID to restrict sign-in.
AUTHORITY_TENANT=common

# Delegated Graph permissions, space separated.
# Every scope listed here must be added under API permissions in Azure.
# Never include openid / profile / offline_access - MSAL adds them itself.
GRAPH_SCOPES=User.Read Mail.Read Calendars.Read Tasks.ReadWrite Chat.Read People.Read MailboxSettings.Read

# --- Application security ----------------------------------------------------
# Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=30

# --- Runtime -----------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false

# --- Database ----------------------------------------------------------------
# SQLite by default; switch to PostgreSQL in production.
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ai_assistant
DATABASE_URL=sqlite+aiosqlite:///./ai_assistant.db

# --- Clients -----------------------------------------------------------------
# Where to send the browser after login. Tokens arrive in the URL fragment.
# Leave empty to receive them as JSON instead (useful while testing).
# React Native deep link example: aiassistant://auth
FRONTEND_REDIRECT_URI=
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081

# --- Personalisation ---------------------------------------------------------
# Addresses or whole domains always treated as high-authority senders.
VIP_CONTACTS=

# --- AI (optional; everything works without it) ------------------------------
# none | anthropic | openai
LLM_PROVIDER=none
# Leave empty to use the provider's default (anthropic -> claude-opus-5,
# openai -> gpt-4o-mini).
LLM_MODEL=
# Claude thinking depth / token spend: low | medium | high | xhigh | max.
LLM_EFFORT=low
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
